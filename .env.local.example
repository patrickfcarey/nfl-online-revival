# Copy to .env.local (gitignored) and fill in. Never commit real values —
# this repo may be public, and rig addresses/users do not belong in history.

# The emulator test rig ("the rig"): where captures run.
RIG_SSH=user@192.168.x.x

# The rig's LAN IP that the emulated console should use as its DNS / server
# target (what you pass to `recon dns --ip`).
RIG_IP=192.168.x.x
