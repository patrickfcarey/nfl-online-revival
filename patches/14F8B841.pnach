gametitle=Madden NFL 2004 (SLUS-20752, CRC 14F8B841)
comment=DNAS bypass, plus the roster-version check

// ---------------------------------------------------------------------------
// WHY
//
// Sony's DNAS servers are gone, so DirtyDnasRelUpdt never reports completion.
// The title sits on "Authenticating DNAS data" and ends at error -610.
//
// THE CODE  (poller at 0x00305238, verified by disassembly)
//
//   00305238  addiu sp, sp, -32
//   0030523c  lbu   v0, -3592(gp)          ; "is DNAS active?" flag
//   00305248  beq   v0, zero, 0x0030527c   ; not active -> return s0
//   0030524c  addiu s0, zero, 1            ; delay slot: default result = 1
//   00305250  jal   0x004f2360             ; DirtyDnasRelUpdt trampoline
//   00305258  beq   v0, zero, 0x00305268   ; Updt == 0 -> completion path
//   00305260  beq   zero, zero, 0x0030527c
//   00305264  addiu s0, zero, 3            ; delay slot: Updt != 0 -> result 3
//   00305268  jal   0x004f2388             ; completion: DirtyDnasRelExit
//   00305270  addiu v1, zero, 2
//   00305274  jal   0x00305080
//   00305278  movn  s0, v1, v0             ; delay slot: s0 = 2 ONLY IF Exit != 0
//   0030527c  daddu v0, s0, zero           ; return s0
//
// So the result is 1, 2 or 3. With dead servers it is 3 forever, which is what
// the endless "Authenticating" screen looks like.
//
// WHAT IS NOT KNOWN
//
// The poller's only caller (0x00353eb0) does not test the value -- it stores it
// with `sw v0, 0(s2)` and jumps to a shared exit, one entry in a dispatch table
// of script-callable functions. Which of 1/2/3 means "proceed" is therefore
// decided by the game's script, not by this executable, and cannot be settled
// by reading the ELF. The variants below are an experiment, not a proof.
//
// Note 0x00305278 is `movn` (conditional), not a plain move: on the completion
// path s0 becomes 2 only when DirtyDnasRelExit returns non-zero, otherwise it
// stays 1. An earlier version of this file claimed that path always returns 2.
// ---------------------------------------------------------------------------

// VARIANT A (active): make the Updt test unconditional, so the poll always
// takes the completion path instead of parking on 3. Updt still runs; its
// verdict just stops holding the title back. Branch target (0x00305268) and
// delay slot are unchanged.
//   before  0x10400003  beq v0,   zero, +3
//   after   0x10000003  beq zero, zero, +3
patch=1,EE,00305258,word,10000003

// VARIANT B: if A leaves it stuck, return 2 immediately -- never calling Updt
// or Exit, so Exit's return value cannot drag the result back down to 1.
// Comment out A and uncomment both lines.
//   00305248: beq v0,zero,+12 -> beq zero,zero,+12   (always take the exit)
//   0030524c: addiu s0,zero,1 -> addiu s0,zero,2     (delay slot: result = 2)
//patch=1,EE,00305248,word,1000000c
//patch=1,EE,0030524c,word,24100002

// VARIANT C: report 1, which is what the title itself returns when DNAS is not
// active -- i.e. make it believe DNAS was never switched on.
//   00305248: beq v0,zero,+12 -> beq zero,zero,+12
//patch=1,EE,00305248,word,1000000c

// SCOPE: any of these gets the title past its own DNAS gate. None obtains a
// DNAS ticket. If the game server later validates one, that is handled
// server-side -- which is fine, because we are writing that server.

// ---------------------------------------------------------------------------
// ROSTER VERSION CHECK  --  no longer needed, left here as a fallback
//
// The title asks the server for a roster DATE and CSUM in its `news` reply and
// compares the checksum against one it computes from its own roster:
//
//   0012a968  jal   0x0012a888        ; local checksum
//   0012a970  lw    v1, -19396(gp)    ; the CSUM the server sent
//   0012a978  xor   v0, v0, v1
//   0012a97c  sltiu v0, v0, 1         ; 1 when identical
//
// This used to be unavoidable: the local value is derived at runtime from the
// console's own roster, so an invented CSUM always mismatched, the title
// offered to update, and the download it then attempted was not implemented --
// the "error updating roster" seen on hardware.
//
// That algorithm has since been reversed and reimplemented in
// tools/roster_checksum.py, so the server can announce a value the console
// agrees with. Run it with `--roster-db DB_TEAMS.DAT` and this patch becomes
// unnecessary; leaving it enabled would also suppress a *legitimate* update
// once rosters genuinely differ, which is the mechanism a roster download will
// hang off. So it is disabled by default.
//
// Re-enable it only to isolate a failure: if the roster prompt returns while
// the server is announcing a computed checksum, turning this back on
// distinguishes "the checksum is wrong" from "something else regressed".
//
//   before  0x00431026  xor   v0, v0, v1
//   after   0x0000102d  daddu v0, zero, zero
//patch=1,EE,0012A978,word,0000102D

// ---------------------------------------------------------------------------
// MEASUREMENT PATCH -- temporary, remove when the checksum is solved
//
// The console never sends us the roster checksum it computes, so a wrong
// algorithm is only visible as "your rosters are out of date" -- one bit of
// feedback per login, with no way to tell which of several candidate
// algorithms is close. Five candidates were tested against hardware and all
// five were rejected, which is where guessing stops being useful.
//
// This makes the console write its own computed value into memory so it can be
// read out of a savestate:
//
//   0012a968  jal   0x0012a888        ; v0 = the checksum the console computed
//   0012a970  lw    v1, -19396(gp)    ; v1 = the checksum we announced
//   0012a978  xor   v0, v0, v1        ; -> REPLACED
//   0012a97c  sltiu v0, v0, 1
//
// gp is 0x006056f0, so gp-19396 is 0x00600b2c -- the slot holding the value we
// sent. It is refilled from the next `news` reply by 0x0012a988.
//
// CORRECTION: an earlier note here said "nothing else reads it". That is
// false. 0x0012a990 is a getter for the same slot and is called from
// 0x00354674, which serialises the value into an outgoing buffer. So this
// patch also makes the console TRANSMIT a wrong checksum, not merely record
// one. Harmless for a measurement run, but it is a second effect.
//
//   before  0x00431026  xor v0, v0, v1
//   after   0xaf82b43c  sw  v0, -19396(gp)
//
// The comparison then tests the checksum against zero instead, so the title
// will always claim the rosters are stale. That is expected -- the point is the
// value at 0x00600b2c, not the verdict.
// ANSWER (2026-07-31): the console computes 0x8108963c -- exactly what
// tools/roster_checksum.py produces. The checksum was never wrong. The prompt
// came from the DATE test at 0x00350960 instead, which asks whether the
// server's date is newer than the console's. Announce DATE=0 and it is not.
// Left disabled rather than deleted: it is the only way to see this value.
//patch=1,EE,0012A978,word,AF82B43C

// ---------------------------------------------------------------------------
// MEASUREMENT PATCH 2 -- the local roster date. Disabled; enable deliberately.
//
// With CSUM matching (measured: the console computes 0x8108963c, exactly what
// tools/roster_checksum.py derives from the disc) and DATE announced as 0, the
// console STILL reports its rosters as out of date. So neither test we know
// about is the trigger, and the decision is made in UI Studio bytecode we
// cannot read -- it lives in the uis_*.dat screen files, not in this ELF.
//
// 0x00350960 answers "is the caller's date older than the one the server
// announced", with the comparison in the delay slot:
//
//   00350960  lw   v0, 2452(gp)     ; the DATE we announced
//   00350964  jr   ra
//   00350968  sltu v0, a0, v0       ; return (a0 < server_DATE)
//
// Replacing the load with a store captures a0 -- the LOCAL roster date the
// script passes in. That answers two things at once: whether this path is
// consulted at all (the slot stays untouched if it is not), and what value the
// script believes its own roster carries.
//
// DANGER: this stores into the CSUM slot, which is live input to the roster
// comparison at 0x0012a970 AND to the getter at 0x0012a990. Enabling it makes
// the console compare its computed checksum against a DATE -- a guaranteed
// mismatch -- and transmit that wrong value. Since the question this patch
// exists to answer is "the checksum matches, so why is it still stale?", it
// manufactures exactly the false negative you would be hunting. Use a
// different scratch slot if this is ever needed again.
//
// The delay slot 0x00350968 `sltu v0, a0, v0` still executes, so the function
// returns sltu(a0, stale v0) rather than "whatever v0 held".
//
//   before  0x8f820994  lw v0, 2452(gp)
//   after   0xaf84b43c  sw a0, -19396(gp)
//
// Read it with: python3 tools/read_roster_checksum.py <savestate>
// Do not enable this at the same time as MEASUREMENT PATCH 1 -- they write the
// same slot, and the last writer wins.
//patch=1,EE,00350960,word,AF84B43C

// ---------------------------------------------------------------------------
// CUSTOM PLAYBOOK: raise the 100-play cap
//
// Create-A-Playbook refuses a 101st play with "there are too many plays in
// this playbook." That message is index 3 of an error table at 0x00599d88:
//
//     0x00599d88  "no error found."
//     0x00599d8c  "this information already exists."
//     0x00599d90  "there are too many formations in this playbook."
//     0x00599d94  "there are too many plays in this playbook."   <- index 3
//
// The string is reached through that table, not a lui/addiu pair, which is
// why searching for a direct reference to it finds nothing.
//
// The chain, from the message back to the decision:
//
//     0x002c3870  error_message(index)      sll a0,a0,2 over the table above
//     0x0029d178  wrapper, returns 0x002c2a88's result as the index
//     0x002c2a88  playbook writer
//     0x002c2c30    s1 = 3                  ("too many plays")
//     0x002c2c34    movn s1, zero, v0       cleared when the gate SUCCEEDS
//     0x002c31e0  gate wrapper, calls the gate below with a1 = 1
//     0x002c32f0  the gate itself
//
// `movn` is conditional -- read as a plain move, 0x002c2c34 looks like it
// always clears the error and the whole chain reads backwards.
//
// The gate, at 0x002c32f0:
//
//     002c3324  lw    v0, 0(sp)      current play count (from the 'PLBP' chunk)
//     002c3328  addu  v0, v0, s0     + a1, the number being added (1)
//     002c332c  sltiu s1, v0, 101    succeed only if count + 1 < 101
//
// So the cap is 100 plays, enforced at exactly one instruction. `a1` is a
// count, not a flag: a1 = 0 returns "no room" via the early branch at
// 0x002c3304, which is why the formations path does not come through here.
//
// 101 is the only such constant in the whole playbook module (0x002be000 to
// 0x002c4000), and the gate has three callers -- 0x00294d0c and 0x00294e68
// (the UI, which greys out "add play") and 0x002c31e8 (the writer). Patching
// this one instruction moves all three together, so the menu and the save
// path cannot disagree about what fits.
//
// DOES PATCHING THIS ALONE WORK? NO. The 100 is not an arbitrary gate.
//
// The playbook lives in a TDB database -- the same format as the rosters --
// queried with SQL built from fragments in the executable ('from', 'where',
// byte-reversed table names). The fourcc the gate passes, 0x4C504250, is the
// table 'LPBP' = PBPL, playbook plays. Its sibling PBFM = playbook formations
// is the other error message.
//
// That database is member 11 of /DATA/TEMPLATE.DAT, and the tables declare
// their own capacity:
//
//     PBPL  capacity 100   8 bytes/record   <- the play cap
//     PBFM  capacity  20  60 bytes/record   <- the formation cap
//     PLYL  capacity 100  40 bytes/record   the play list itself
//     PLRD  capacity 100 / PLPD capacity 100   parallel per-play tables
//
// A TDB data block is sized exactly field_count*16 + record_bytes*max_records
// with no slack: PBPL's block is 864 bytes = 4*16 + 8*100, and the NEXT
// table's header begins at the byte after it. Row 101 does not overflow into
// padding, it overwrites the neighbouring table header.
//
// So `sltiu s1, v0, 101` is the table's capacity spelled out in code. Raising
// it lets the UI accept a 101st play and then corrupts the database.
//
// TO ACTUALLY RAISE IT, the tables have to grow first: enlarge PBPL, PLYL,
// PLRD and PLPD (and PLYS/PSAL/ARTL, which hold the route art a play points
// at) in member 11, re-seal the block checksums -- tools/mark_roster.py
// already does exactly this for the roster database -- and then patch this
// instruction to match the new capacity. The save is written from that
// template, so its size follows.
//
// The line below is left commented out because on its own it is harmful.
// Uncomment only alongside an enlarged TEMPLATE.DAT, with the immediate set
// to the new capacity PLUS ONE (sign-extended, so keep it under 32767):
//
//   patch=1,EE,002c332c,word,2c510191   // 400 plays -- needs enlarged tables
